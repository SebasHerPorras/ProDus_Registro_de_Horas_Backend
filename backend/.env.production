# ============================================
# CONFIGURACIÓN DEL BACKEND - PRODUCCIÓN
# ============================================
# Copiar este archivo como .env en el servidor de producción

# Django Settings
DEBUG=False
SECRET_KEY=genera-una-key-segura-usando-python-secrets
ALLOWED_HOSTS=tu-dominio.com,api.tu-dominio.com

# Database PostgreSQL
DB_ENGINE=django.db.backends.postgresql
DB_NAME=produs_horas_prod
DB_USER=produs_user
DB_PASSWORD=password-super-seguro-de-produccion
DB_HOST=localhost
DB_PORT=5432

# CORS - URLs del frontend permitidas (separadas por coma)
CORS_ALLOWED_ORIGINS=https://tu-dominio.com,https://www.tu-dominio.com

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME_HOURS=8
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# IP Validation - IMPORTANTE: Poner False en producción
ALLOW_ALL_IPS=False
ALLOWED_IPS=IP.PUBLICA.DEL.INSTITUTO
