# ============================================
# CONFIGURACIÓN DEL BACKEND - ProDus Horas
# ============================================
# Copia este archivo como .env y configura tus valores

# Django Settings
DEBUG=True
SECRET_KEY=tu-secret-key-super-segura-cambiar-en-produccion
ALLOWED_HOSTS=localhost,127.0.0.1

# Database PostgreSQL
DB_ENGINE=django.db.backends.postgresql
DB_NAME=produs_horas
DB_USER=postgres
DB_PASSWORD=tu_password_seguro
DB_HOST=localhost
DB_PORT=5432

# CORS - URLs del frontend permitidas (separadas por coma)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME_HOURS=8
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# IP Validation
ALLOW_ALL_IPS=True
ALLOWED_IPS=127.0.0.1,::1
