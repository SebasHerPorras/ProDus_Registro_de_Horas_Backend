# ============================================
# CONFIGURACIÓN DE DJANGO
# ============================================

# Clave secreta de Django (cambiar en producción)
SECRET_KEY=django-insecure-dev-key-change-in-production

# Modo debug (True para desarrollo, False para producción)
DEBUG=True

# Hosts permitidos (separados por coma)
ALLOWED_HOSTS=localhost,127.0.0.1


# ============================================
# CONFIGURACIÓN DE BASE DE DATOS (PostgreSQL)
# ============================================

# Motor de base de datos
DB_ENGINE=django.db.backends.postgresql

# Nombre de la base de datos
DB_NAME=produs_horas

# Usuario de la base de datos
DB_USER=postgres

# Contraseña de la base de datos
DB_PASSWORD=postgres

# Host de la base de datos
DB_HOST=localhost

# Puerto de la base de datos
DB_PORT=5432


# ============================================
# CONFIGURACIÓN DE JWT (Tokens)
# ============================================

# Tiempo de vida del access token en horas
JWT_ACCESS_TOKEN_LIFETIME_HOURS=8

# Tiempo de vida del refresh token en días
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7


# ============================================
# CONFIGURACIÓN DE CORS (Frontend)
# ============================================

# Orígenes permitidos para CORS (separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# ============================================
# CONFIGURACIÓN DE SEGURIDAD (Validación de IP)
# ============================================

# Permitir todas las IPs (True para desarrollo, False para producción)
# En producción, solo se permitirán IPs registradas en AllowedIPRange
ALLOW_ALL_IPS=True
